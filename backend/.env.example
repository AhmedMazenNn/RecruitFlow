# ============================================
# RecruitFlow — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================

# Django
# -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL — used in all environments)
# -------------------------------------------------------------------
# Create the database first, e.g.:
#   createdb recruitflow
# These values must match your local PostgreSQL server.
DATABASE_NAME=recruitflow
DATABASE_USER=recruitflow_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# JWT Token Lifetimes (in minutes / days)
# -------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME=30
REFRESH_TOKEN_LIFETIME=1

# Email
# -------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=RecruitFlow <noreply@recruitflow.com>

# Frontend
# -------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Localization
# -------------------------------------------------------------------
TIME_ZONE=UTC
LANGUAGE_CODE=en-us
